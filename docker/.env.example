# Storage and config paths
STORAGE_BASE=/home/ubuntu/my-nas/nas-volumes
CONFIG_MODE=dev  # dev=bind mount from source, prod=bind mount from STORAGE_BASE/configs

# Credentials
NAS_USER=admin
NAS_PASSWORD=password

# VPN Credentials (optional if using credentials.conf)
# VPN_USER=
# VPN_PASS=

# Network
LAN_NETWORK=************/24
